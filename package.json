{
  "name": "neiphos-ticket-machine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline Kiosk-Spielesammlung fuer einen umgebauten Fahrkartenautomaten (Raspberry Pi + Chromium Kiosk-Mode).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "serve": "node server/serve.js dist 8080"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
